---
import { createOrganizationSchema } from "../lib/seo";
const { head, entry, lang, isFallback } = Astro.locals.starlightRoute;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const socialImageUrl = new URL(
  `${base}images/wiki-transition-poster-v1.jpg`,
  Astro.site,
);
const sitemapUrl = new URL(`${base}sitemap-index.xml`, Astro.site);
const hasMeta = (attribute: "name" | "property", value: string) =>
  head.some(({ tag, attrs }) => tag === "meta" && attrs?.[attribute] === value);
const hasLink = (rel: string) =>
  head.some(({ tag, attrs }) => tag === "link" && attrs?.rel === rel);
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: entry.data.title,
  description: entry.data.description,
  inLanguage: lang,
  url: Astro.url.href,
  image: socialImageUrl.href,
  publisher: createOrganizationSchema(
    new URL(base, Astro.site),
    new URL(`${base}favicon.svg?v=transparent-circle`, Astro.site),
  ),
};
const serializedArticleSchema = JSON.stringify(articleSchema).replaceAll("</", "<\\/");
---

{head.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}
{isFallback && !hasMeta("name", "robots") && <meta name="robots" content="noindex,follow" />}
{!hasMeta("property", "og:image") && <meta property="og:image" content={socialImageUrl.href} />}
{!hasMeta("property", "og:image:alt") && <meta property="og:image:alt" content="LearnPrompt AI Practice Wiki" />}
{!hasMeta("name", "twitter:image") && <meta name="twitter:image" content={socialImageUrl.href} />}
{!hasLink("sitemap") && <link rel="sitemap" href={sitemapUrl.href} />}
{!isFallback && <script type="application/ld+json" set:html={serializedArticleSchema} />}
